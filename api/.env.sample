# Direct (non-pooled) Neon connection string — required for Drizzle schema pushes and all queries.
# Use the "Direct connection" URL from Neon's dashboard (no -pooler in the hostname).
# Dev and prod should each point at their own Neon database or branch.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# TMDB API key — free non-commercial key from https://developer.themoviedb.org
TMDB_API_KEY=

# Admin secret — any strong random string. Must match VITE_ADMIN_SECRET in web/.env.
ADMIN_SECRET=

# Port for the Apollo Server (defaults to 4100 if unset)
PORT=4100
