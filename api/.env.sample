# Neon PostgreSQL direct (non-pooled) connection string
# Use the direct URL, not the pooled PgBouncer URL — required for Drizzle migrations
DATABASE_URL=

# TMDB API key — free non-commercial key from https://developer.themoviedb.org
TMDB_API_KEY=

# Admin secret — any strong random string. Must match VITE_ADMIN_SECRET in web/.env.
ADMIN_SECRET=

# Port for the Apollo Server (defaults to 4100 if unset)
PORT=4100
