# Direct (non-pooled) Neon connection string — required for Drizzle schema pushes and all queries.
# Use the "Direct connection" URL from Neon's dashboard (no -pooler in the hostname).
# Dev and prod should each point at their own Neon database or branch.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Port for the Apollo Server (defaults to 4100 if unset)
PORT=4100

# Public URL of this API server — used to build the GitHub OAuth callback URL.
# Local dev: http://localhost:4100  Prod: https://mite-mite-api.onrender.com
API_URL=http://localhost:4100

# Public URL of the web frontend — used as the CORS origin and as the redirect
# target after OAuth login (e.g. http://localhost:4000 for local dev).
WEB_URL=http://localhost:4000

# GitHub OAuth app credentials — create an app at https://github.com/settings/developers.
# Set the callback URL to <API_URL>/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub username of the sole admin. OAuth logins are checked against this value
# (case-insensitive). Only this user receives an admin session cookie.
ADMIN_GITHUB_USERNAME=

# Secret used to sign session JWTs — any strong random string (e.g. openssl rand -hex 32).
JWT_SECRET=
